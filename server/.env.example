PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gardener-guide?retryWrites=true&w=majority
CLIENT_ORIGIN=http://localhost:5173

# Required: a long random string (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Plant disease detection
# "claude" (default) calls the Anthropic API and needs ANTHROPIC_API_KEY.
# "mock" is an offline demo that does NOT analyse the image: for local development only.
DETECTOR_PROVIDER=claude
ANTHROPIC_API_KEY=
# Optional: use a different/cheaper model than the default
# DETECTOR_MODEL=
# Photo checks allowed per user per hour (each one costs an API call)
DIAGNOSE_RATE_LIMIT=10

# "Sign in with Google" (optional). A public client ID from Google Cloud Console; see docs/GOOGLE_LOGIN.md.
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
